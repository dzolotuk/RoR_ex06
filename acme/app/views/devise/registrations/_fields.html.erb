<div class="field">
  <%= f.label :name %>
  <%= f.text_field :name, autofocus: true %>
</div>

<div class="field">
  <%= f.label :email %>
  <%= f.email_field :email, autocomplete: 'email' %>
</div>

<div class="field">
  <%= f.label :bio, 'Biography (optional)' %>
  <%= f.text_area :bio, rows: 5, cols: 50 %>
</div>
