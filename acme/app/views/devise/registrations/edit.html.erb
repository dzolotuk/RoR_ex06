<h1>My account</h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render 'shared/errors', record: resource %>
  <%= render 'devise/registrations/fields', f: f %>

  <div class="field">
    <%= f.label :password, 'New password (leave blank to keep the current one)' %>
    <%= f.password_field :password, autocomplete: 'new-password' %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, 'Confirm the new password' %>
    <%= f.password_field :password_confirmation, autocomplete: 'new-password' %>
  </div>

  <div class="field">
    <%= f.label :current_password, 'Current password (needed to save the changes)' %>
    <%= f.password_field :current_password, autocomplete: 'current-password' %>
  </div>

  <%= f.submit 'Save' %>
<% end %>
