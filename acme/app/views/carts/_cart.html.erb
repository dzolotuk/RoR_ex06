<section id="cart">
  <h2>Cart</h2>

  <% if cart.empty? %>
    <p>Your cart is empty.</p>
  <% else %>
    <table>
      <thead>
        <tr><th>Item</th><th>Quantity</th><th></th><th>Price</th></tr>
      </thead>
      <tbody>
        <% cart.cart_items.includes(:product).each do |item| %>
          <tr id="cart_item_<%= item.id %>">
            <td><%= link_to item.product.name, product_path(item.product) %></td>
            <td class="quantity"><%= item.quantity %></td>
            <td class="buttons">
              <%= button_to '-', decrease_cart_item_path(item), method: :patch, title: 'One less' %>
              <%= button_to '+', increase_cart_item_path(item), method: :patch, title: 'One more' %>
            </td>
            <td class="line-total"><%= price_tag(item.line_total) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr><th colspan="3">Total</th><th class="total"><%= price_tag(cart.total) %></th></tr>
      </tfoot>
    </table>

    <div class="cart-buttons">
      <%= button_to 'Checkout', orders_path %>
      <%= button_to 'Cancel the cart', cart_path, method: :delete %>
    </div>
  <% end %>
</section>
