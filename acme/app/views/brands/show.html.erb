<h1><%= @brand.name %></h1>
<%= image_tag @brand.avatar.thumb.url, alt: @brand.name, class: 'thumb' %>

<h2>Products</h2>
<div class="with-cart">
  <div class="catalog">
    <%= render 'products/grid', paginator: @paginator %>
  </div>
  <aside>
    <%= render 'carts/cart', cart: current_cart %>
  </aside>
</div>

<p><%= link_to '« All the brands', brands_path %></p>
