<h1>Order summary</h1>
<p>Order number <%= @order.id %>, <%= l(@order.created_at, format: :short) %></p>

<table id="order">
  <thead>
    <tr><th>Item</th><th>Unit price</th><th>Quantity</th><th>Price</th></tr>
  </thead>
  <tbody>
    <% @order.order_items.each do |item| %>
      <tr>
        <td><%= item.name %></td>
        <td><%= price_tag(item.unit_price) %></td>
        <td><%= item.quantity %></td>
        <td><%= price_tag(item.line_total) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr><th colspan="3">Total</th><th class="total"><%= price_tag(@order.total) %></th></tr>
  </tfoot>
</table>

<p><%= link_to '« Back to the catalog', products_path %></p>
