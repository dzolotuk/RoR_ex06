<% if paginator.total_pages > 1 %>
  <p class="pagination">
    <% if paginator.previous_page %>
      <%= link_to '« Previous', url_for(page: paginator.previous_page) %>
    <% end %>
    Page <%= paginator.number %> / <%= paginator.total_pages %>
    <% if paginator.next_page %>
      <%= link_to 'Next »', url_for(page: paginator.next_page) %>
    <% end %>
  </p>
<% end %>
